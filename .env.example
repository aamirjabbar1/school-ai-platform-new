# ══════════════════════════════════════════════════════════════════════════════
#  School AI Platform — environment variables
#  Copy this file to .env and fill in every value marked REQUIRED.
#  Variables with a default in docker-compose.yml are marked OPTIONAL.
# ══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=school_ai_db          # OPTIONAL  (default: school_ai_db)
DB_USER=postgres              # OPTIONAL  (default: postgres)
DB_PASSWORD=                  # REQUIRED  — choose a strong password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Internal Docker service URL — do not change unless you use an external Redis
REDIS_URL=redis://redis:6379/0   # OPTIONAL  (default: redis://redis:6379/0)

# ─── MinIO object storage ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin    # OPTIONAL  (default: minioadmin)
MINIO_ROOT_PASSWORD=          # REQUIRED  — choose a strong password

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -hex 32
JWT_SECRET=                   # REQUIRED

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # REQUIRED  — get from console.anthropic.com
AI_MODEL=claude-opus-4-6      # OPTIONAL  (default: claude-opus-4-6)

# ─── Online Classes (LiveKit media server) ────────────────────────────────────
# Runs on its own host — see deploy/livekit/. Leave blank to keep Online
# Classes switched off; the rest of LSS Bot is unaffected either way.
# Generate a key/secret pair with:  docker run --rm livekit/generate --keys
LIVEKIT_URL=                  # OPTIONAL  e.g. wss://live.lssbot.net
LIVEKIT_HTTP_URL=             # OPTIONAL  e.g. https://live.lssbot.net
LIVEKIT_API_KEY=              # OPTIONAL  — must match the media server
LIVEKIT_API_SECRET=           # OPTIONAL  — server-side only, never sent to a browser
LIVEKIT_TOKEN_TTL_HOURS=3     # OPTIONAL  (default: 3)

# ─── Class recordings (Phase 3, optional) ─────────────────────────────────────
# The recorder uploads finished MP4s straight to object storage, so this
# endpoint must be reachable FROM THE MEDIA HOST — put it behind TLS rather
# than exposing MinIO in the clear. Recordings are media only: nothing
# transcribes them and no AI model is given access to them.
RECORDING_BUCKET=class-recordings   # OPTIONAL  (default: class-recordings)
RECORDING_S3_ENDPOINT=              # OPTIONAL  e.g. https://minio.lssbot.net — blank disables recording
RECORDING_S3_ACCESS_KEY=            # OPTIONAL  (defaults to the MinIO credentials)
RECORDING_S3_SECRET_KEY=            # OPTIONAL
RECORDING_S3_REGION=us-east-1       # OPTIONAL

# ─── AI model routing (spec §19D) ─────────────────────────────────────────────
# Summaries and revision notes run on the cheaper model; typed student
# questions and the teacher assistant use the capable one. Administrators can
# override per feature from Admin → Live Classes → Settings.
AI_MODEL_FAST=claude-haiku-4-5      # OPTIONAL  (default: claude-haiku-4-5)

# ─── School branding ──────────────────────────────────────────────────────────
SCHOOL_NAME=My School         # OPTIONAL
SCHOOL_TAGLINE=Excellence in Education   # OPTIONAL
# In production set this to your real domain, e.g. https://school.example.com
FRONTEND_URL=http://localhost  # OPTIONAL  (default: http://localhost)
