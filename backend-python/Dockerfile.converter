# ─── Document conversion worker ──────────────────────────────────────────────
#
# A Celery worker with headless LibreOffice, used to turn PowerPoint and Word
# files into PDFs the classroom can present. It is a separate image because
# LibreOffice adds several hundred megabytes and occasionally wedges on a
# malformed file — neither of which should be true of the API container.
#
# Only the `conversion` queue is consumed here, so a stuck conversion cannot
# delay document ingestion or anything a live class depends on.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-core \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-calc \
        fonts-dejavu \
        fonts-liberation \
        # Urdu and Arabic script material must convert with joined letterforms
        fonts-noto-core \
        fonts-noto-extra \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Warm the LibreOffice profile at build time so the first real conversion of
# the day is not the one that pays for it.
RUN soffice --headless --norestore --invisible --terminate_after_init || true

CMD ["celery", "-A", "celery_app", "worker", "--loglevel=info", \
     "--concurrency=2", "-Q", "conversion", "-n", "converter@%h"]
